{% schema %}
  {
    "name": "Featured Collections Grid",
    "settings": [],
    "blocks": [
      {
        "type": "collection_card",
        "name": "Collection Card",
        "settings": [
          {
            "type": "color",
            "id": "background_color",
            "label": "Background Color",
            "default": "#FFFFFF"
          },
          {
            "type": "collection",
            "id": "collection",
            "label": "Collection"
          },
          {
            "type": "checkbox",
            "id": "fill_block",
            "label": "Fill Entire Block with Collection Card",
            "default": false
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Block Heading"
          }, {
            "type": "text",
            "id": "description",
            "label": "Description",
            "default": "Block description"
          }, {
            "type": "url",
            "id": "button_link",
            "label": "Button Link",
            "default": "/"
          }
        ]
      }
    ],
    "max_blocks": 3
  }
{% endschema %}