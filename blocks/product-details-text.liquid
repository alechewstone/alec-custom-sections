<div class="product-details__block" {{ block.shopify_attributes }}>
  {% assign attr = block.settings.standard_attribute %}
  {% assign custom_key = block.settings.custom_metafield %}

  {% case attr %}
    {% when "vendor" %}
      <h4>Vendor</h4>
      <p>{{ product.vendor }}</p>

    {% when "product_type" %}
      <h4>Product Type</h4>
      <p>{{ product.type }}</p>

    {% when "product_category" %}
      <h4>Product Category</h4>
      <p>{{ product.category }}</p>

    {% when "sku" %}
      {% if product.variants.first.sku == blank %}
        <h4>SKU</h4>
        <p>No SKU available</p>
      {% else %}
        <h4>SKU</h4>
        <p>{{ product.variants.first.sku }}</p>
      {% endif %}

    {% when "available" %}
      <h4>Availability</h4>
      <p>
        {% if product.available %}
          In stock
        {% else %}
          Sold out
        {% endif %}
      </p>

    {% when "tags" %}
      <h4>Tags</h4>
      <p>{{ product.tags | join: ", " }}</p>

    {% when "color" %}
      {% assign color_option = product.options_with_values | where: "name", "Color" | first %}
      {% if color_option %}
        <h4>Color</h4>
        <p>{{ color_option.values | join: ", " }}</p>
      {% endif %}
  {% endcase %}

  {% unless attr != "" or custom_key == blank %}
    {%- assign parts = custom_key | split: '.' -%}
    {%- assign ns = parts[0] -%}
    {%- assign key = parts[1] -%}
    {%- assign mf = product.metafields[ns][key] -%}

    {% if mf %}
      <h4>
        {% assign words = key | split: '_' %}
        {% for word in words %}
          {{ word | capitalize }}{% unless forloop.last %}
          {% endunless %}
        {% endfor %}
      </h4>
      <p>{{ mf.value }}</p>
    {% endif %}
  {% endunless %}

  {% if block.settings.custom_metafield == blank and attr == blank %}
    <h4>Metafield</h4>
    <p>No metafield or standard attribute selected</p>
  {% endif %}
</div>


{% schema %}
  {
    "name": "Product Details Block",
    "settings": [
      {
        "type": "header",
        "content": "For standard product fields:"
      },
      {
        "type": "select",
        "id": "standard_attribute",
        "label": "Standard Product Field",
        "options": [
          {
            "value": "",
            "label": ""
          },
          {
            "value": "available",
            "label": "Availability (In stock / Sold out)"
          },
          {
            "value": "color",
            "label": "Color (from options)"
          },
          {
            "value": "product_type",
            "label": "Product type"
          }, {
            "value": "product_category",
            "label": "Product category"
          }, {
            "value": "sku",
            "label": "SKU (first variant)"
          }, {
            "value": "tags",
            "label": "Product tags"
          }, {
            "value": "vendor",
            "label": "Vendor"
          }
        ],
        "default": ""
      },
      {
        "type": "header",
        "content": "For custom product fields:"
      },
      {
        "type": "text",
        "id": "custom_metafield",
        "label": "Custom Product Metafield",
        "info": "NOTE: Shopify does not support dynamic metafield keys. Use the format 'namespace.key', e.g 'custom.color' as per instructions below."
      }, {
        "type": "paragraph",
        "content": "How to find the metafield key:"
      }, {
        "type": "paragraph",
        "content": "1. Go to the product in Shopify admin."
      }, {
        "type": "paragraph",
        "content": "2. Scroll to the 'Metafields' section."
      }, {
        "type": "paragraph",
        "content": "3. Click on the metafield name to open the metafield settings."
      }, {
        "type": "paragraph",
        "content": "4. Copy the 'Namespace and key' value (near the top in the first pill)."
      }
    ],
    "presets": [
      {
        "name": "Product Details Block"
      }
    ]
  }
{% endschema %}